# ChatExp terminal client — LLM configuration (copy to .env and fill in)
CHATEXP_OPENAI_API_KEY=
CHATEXP_OPENAI_BASE_URL=https://your-endpoint/v1
CHATEXP_OPENAI_MODEL=your-model-name
CHATEXP_OPENAI_TIMEOUT_SECONDS=180
# Output budget; raising it does NOT send full Excel data to the LLM.
CHATEXP_OPENAI_MAX_TOKENS=131072

# ── BO backend (chatexp-api service): remote-first design suggestions ──
# When set, generate_next_design calls POST /v1/bo/suggest and falls back to
# the local engine if the service is unreachable.
CHATEXP_BO_API_ENDPOINT=
CHATEXP_BO_API_KEY=
CHATEXP_BO_API_TIMEOUT_SECONDS=600
# CHATEXP_BO_RUNTIME_CANDIDATE_POOL_SIZE=2048
# CHATEXP_BO_RUNTIME_ENSEMBLE_SIZE=5
# CHATEXP_BO_RUNTIME_TRAINING_STEPS=300

# ── Campaign strategist (LLM helps BO; NO rule fallback) ──
# llm = the LLM strategist reviews the objective state before each batch.
# off (default) = disabled. There is no rule-based fallback mode.
CHATEXP_STRATEGIST=off
