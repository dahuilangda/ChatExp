# chatexp-api configuration. Copy to .env and fill in.
# See deploy/README.md for the HTTPS deployment guide (required for HTTPS SeaTable).

# BO API key. Gates /v1/bo/*, /v1/jobs/*, and the /v1/files/* routes. Leave
# EMPTY to disable key checking on those routes (NOT recommended for any
# internet-facing deployment). TWO routes are STRICT regardless: POST
# /v1/llm/chat and POST /v1/files/edit (LLM-cost-incurring, large bodies)
# refuse every request with 503 until this key is set — set it at minimum.
# REQUIRED for /v1/files/analyze (and management endpoints): the analysis
# agent forwards content to a client-named LLM endpoint and burns real
# tokens, so analyze REFUSES with 503 until this key is set. The SeaTable
# plugin sends the same key as its BO API key. Parse/poll routes stay open
# when unset (docling CPU only), but setting this key is recommended.
CHATEXP_BO_API_KEY=
# Separate key for the document-management routes (/v1/files/docs*, /v1/files/stats*).
# When unset, management falls back to CHATEXP_BO_API_KEY.
CHATEXP_ADMIN_API_KEY=

# CORS origins allowed by the browser. Default * is safe here because the API
# uses allow_credentials=False and authenticates via the Authorization header
# (not cookies). Keep * when distributing the plugin to users on many SeaTable
# domains. To lock down to specific origins, set them comma-separated:
#   CHATEXP_CORS_ORIGINS=https://seatable-a.example.com,https://seatable-b.example.com
CHATEXP_CORS_ORIGINS=*

# Server-side LLM (called by /v1/llm/chat via urllib). This can be HTTP because
# the call is server-side and is NOT subject to browser mixed-content rules.
CHATEXP_LLM_ENDPOINT=
CHATEXP_LLM_API_KEY=
CHATEXP_LLM_MODEL=
CHATEXP_LLM_RESPONSE_FORMAT=true
CHATEXP_LLM_MAX_TOKENS=8192

# Allow-list of model base URLs the proxy will call. Must include the host:port
# portion of CHATEXP_LLM_ENDPOINT. Comma-separated.
CHATEXP_LLM_PROXY_ALLOWED_BASE_URLS=
# Upstream LLM call timeout (seconds). Default 180 matches the plugin's
# planner timeout so a long planner call is never cut off server-side while
# the client still waits (avoiding wasted full-payload retries).
CHATEXP_LLM_PROXY_TIMEOUT_SECONDS=180

# PyTorch wheel index (CPU by default). Change to a CUDA index for GPU workers.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# ---------------------------------------------------------------------------
# File parsing (chatexp-api -> docling-serve). All parsing runs locally; no
# document bytes ever leave the host. docling-serve runs as a sibling container
# on the chatexp_bo network and is reached at http://docling-serve:5001.
# Leave CHATEXP_DOCLING_BASE_URL empty to disable server-side parsing (the
# plugin then falls back to its in-browser text extraction).
# ---------------------------------------------------------------------------
# Base URL of the docling-serve v1 API.
CHATEXP_DOCLING_BASE_URL=http://docling-serve:5001
# Per-request timeout for a single docling conversion (seconds).
CHATEXP_DOCLING_TIMEOUT_SECONDS=300
# Max bytes the server will download from SeaTable for one attachment.
CHATEXP_FILE_MAX_BYTES=52428800
# TTL (seconds) of parsed-document cache entries in redis.
CHATEXP_FILE_CACHE_TTL=86400
# SeaTable app-download-link endpoint timeout (seconds).
CHATEXP_SEATABLE_TIMEOUT_SECONDS=60

# --- Parsed-file management (two-tier storage) ----------------------------
# Shared volume (mounted at this path in BOTH api and worker containers) where
# parsed artifacts (blocks/markdown/tables) are stored. Multi-MB payloads live
# here; redis holds only lightweight metadata to stay small.
CHATEXP_PARSED_FILES_DIR=/workspace/parsed-files
# High-water mark for the parsed-files volume; the LRU cleanup evicts oldest.
CHATEXP_PARSED_FILES_MAX_BYTES=2147483648
# Per-document parse/dedup lock TTL (covers download + docling).
CHATEXP_PARSE_LOCK_TTL_SECONDS=600
# redis maxmemory cap for the registry metadata + celery queues. The allkeys-lru
# policy is set in docker-compose and keeps redis bounded.
CHATEXP_REDIS_MAXMEMORY=256mb
# SeaTable API-Token (base-level, generated in the SeaTable UI for the target base).
# Used by the worker to resolve app-download-link when the plugin cannot supply
# dtablePluginConfig.APIToken (integrated plugins often receive an empty token).
# Generate: SeaTable UI -> your base -> Advanced/API -> Add new API token (read ok).
CHATEXP_SEATABLE_API_TOKEN=
# SeaTable server base URL (e.g. https://oa.vicrobx.com). Fallback when the
# plugin payload omits server.
CHATEXP_SEATABLE_SERVER=
