# HTTPS reverse proxy; supply your certificate pair in deploy/certs/.
:{$CHATEXP_HTTPS_PORT} {
	tls /certs/fullchain.pem /certs/privkey.pem

	# Wire compression (server occupancy): JSON API responses (analysis, BO,
	# document text) shrink ~5-10x. Skips responses already compressed
	# upstream (FastAPI GZipMiddleware sets Content-Encoding).
	encode zstd gzip

	# Everything -> chatexp-api. CORS (including OPTIONS preflight) is handled
	# by FastAPI's CORSMiddleware upstream, so we just forward transparently.
	reverse_proxy api:8000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
